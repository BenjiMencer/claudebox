#!/usr/bin/env bash
# Install a project's dependencies for claudebox, without giving the agent
# network access and without putting package code on your host filesystem.
#
#   claudebox-install            install what the manifests declare
#   claudebox-install pypdf ...   add packages without touching the manifests
#   claudebox-install --strict   force the strict policy
#   claudebox-install --lenient  force the lenient policy
#   claudebox-install --clean    delete this project's dependency volumes
#
# Two tiers, on purpose. requirements.txt / package.json are the declared set:
# what a folder is meant to have, reinstalled whenever the volumes are rebuilt.
# Named packages are added to the environment for the work in hand and are not
# recorded anywhere, so they don't survive a --clean or reach another machine.
# Promote something by writing it into the manifest and installing again.
#
# A throwaway container fetches the packages and writes them into a Docker
# named volume, which the launchers mount over node_modules / .venv. It gets no
# SCANNER_TOKEN, no API key, and no added capabilities, and it exits when the
# install finishes. The agent's own network posture is untouched.
#
# Policy follows the sandbox gate, the same signal that decides permission
# prompts (see sandbox-gate.sh):
#
#   sandbox root  lenient  lifecycle scripts run, lockfile written if missing,
#                          project mounted read-write
#   elsewhere     strict   scripts disabled, lockfile required, only the
#                          manifest is mounted, read-only
#
# Leniency lands where the blast radius is already disposable, and real projects
# keep the guardrails, without a flag to remember in either case.
#
# The agent cannot run this. Letting it would mean handing it the Docker socket,
# which is a container escape to host root. You are the trigger on purpose.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$REPO_DIR/deps-volumes.sh"
source "$REPO_DIR/sandbox-gate.sh"

IMAGE="${CLAUDEBOX_IMAGE:-cc-agent}"
FORCE_POLICY=""
CLEAN=0
PKGS=""

# A package name reaches a shell inside the sidecar, and under the watcher it
# originates with the agent - so it is untrusted input. Allow only what a real
# requirement spec needs (pypdf, pypdf==6.14.2, requests[socks], numpy>=1.20)
# and reject everything else rather than trying to quote around it.
valid_pkg() {
  printf '%s' "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9._-]*(\[[A-Za-z0-9,._-]+\])?([=<>!~]{1,2}[A-Za-z0-9._*-]+)?$'
}

for arg in "$@"; do
  case "$arg" in
    --strict)  FORCE_POLICY=strict ;;
    --lenient) FORCE_POLICY=lenient ;;
    --clean)   CLEAN=1 ;;
    -h|--help) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "claudebox-install: unknown option '$arg'" >&2; exit 1 ;;
    *)
      valid_pkg "$arg" || {
        echo "claudebox-install: refusing '$arg' - not a plain package spec." >&2
        exit 1
      }
      PKGS="$PKGS $arg"
      ;;
  esac
done

command -v docker > /dev/null 2>&1 || { echo "claudebox-install: docker not found." >&2; exit 1; }
docker info > /dev/null 2>&1 || { echo "claudebox-install: Docker isn't running." >&2; exit 1; }

claudebox_deps_volumes

if [ -n "$PKGS" ]; then
  ADHOC=1
elif [ "$CLAUDEBOX_HAS_NODE" = 0 ] && [ "$CLAUDEBOX_HAS_PY" = 0 ]; then
  echo "claudebox-install: nothing to install here." >&2
  echo "  Looked for package.json, requirements.txt, pyproject.toml in $PWD" >&2
  echo "  To add a package without a manifest: claudebox-install <name>" >&2
  exit 1
fi

if [ "$CLEAN" = 1 ]; then
  for vol in "$CLAUDEBOX_VOL_NODE" "$CLAUDEBOX_VOL_PY"; do
    [ -n "$vol" ] || continue
    claudebox_volume_exists "$vol" \
      && docker volume rm "$vol" > /dev/null \
      && echo "claudebox-install: removed $vol"
  done
  exit 0
fi

docker image inspect "$IMAGE" > /dev/null 2>&1 || {
  echo "claudebox-install: image '$IMAGE' not found. Build it first (claude-local --rebuild)." >&2
  exit 1
}

if [ -n "$FORCE_POLICY" ]; then
  POLICY="$FORCE_POLICY"
else
  claudebox_check_sandbox
  [ "$CLAUDEBOX_BYPASS" = 1 ] && POLICY=lenient || POLICY=strict
fi
echo "claudebox-install: $POLICY policy"

# The sidecar runs the SAME image as the agent, so interpreters and ABI match
# exactly. A venv built by a different Python, or a native module built against
# a different libc, is visible inside claudebox but doesn't load.
#
# Ownership: a fresh named volume is root-owned and the agent runs unprivileged,
# so the install runs as root and hands the tree over at the end. Read the uid
# from the image rather than hardcoding it - the base image already occupies
# 1000, so ccagent is not the number you would guess.
CCAGENT_UID="$(docker run --rm --entrypoint sh "$IMAGE" -c 'id -u ccagent')"
CCAGENT_GID="$(docker run --rm --entrypoint sh "$IMAGE" -c 'id -g ccagent')"
CHOWN="chown -R ${CCAGENT_UID}:${CCAGENT_GID}"

sidecar() { docker run --rm --entrypoint sh "$@"; }

# Everything installs into a named volume, so package code stays off the host.
# Whether the running agent can see it depends on the volume having been mounted
# when its container started - report that accurately rather than always telling
# people to restart.
# A volume attaches when a container starts, so a session that began before
# this install has no way to see it. Rather than telling the agent to restart -
# which it cannot do - stream the tree into the running container.
#
# The pipe means package code never touches host disk, and the destination is
# outside the bind-mounted work directory on purpose: docker cp into a bind
# mount writes through to the Mac, which is the thing being avoided.
sync_into_running_container() {
  sync_vol="$1"; sync_dest="$2"
  sync_container="$(claudebox_container_name)"

  [ "$(docker inspect -f '{{.State.Running}}' "$sync_container" 2> /dev/null)" = true ] || return 0
  # Already attached? Then it is a live view of the volume and needs nothing.
  docker inspect "$sync_container" \
    --format '{{range .Mounts}}{{.Name}} {{end}}' 2> /dev/null \
    | tr ' ' '\n' | grep -qx "$sync_vol" && return 0

  echo "claudebox-install: copying into the running $sync_container ..."

  # As ccagent, not root. The agent container runs --cap-drop=ALL, which takes
  # CAP_DAC_OVERRIDE and CAP_CHOWN away from root as well - so root there cannot
  # create or chown anything under /home/ccagent, while ccagent can, because it
  # owns the directory. Getting this wrong fails with "Permission denied" from
  # root, which reads like a sandbox rule rather than a missing capability.
  docker exec -u ccagent "$sync_container" mkdir -p "$sync_dest" || {
    echo "claudebox-install: could not create $sync_dest in $sync_container." >&2
    return 1
  }

  # No chown afterwards, for the same reason: nothing in that container can
  # perform one. It isn't needed - the sidecar already chowned the volume, and
  # docker cp carries the archive's uid/gid through. (Not `docker cp -a`, which
  # fails here trying to resolve 1001 in the host passwd database.)
  docker run --rm -v "$sync_vol":/src --entrypoint tar "$IMAGE" -C /src -cf - . \
    | docker cp - "$sync_container:$sync_dest"
}

# ----------------------------------------------------------------- ad-hoc ---
# Named packages. Note what is NOT mounted here: the project. A manifest install
# needs the project to read (and sometimes write) manifests, but this needs only
# the name, so the sidecar gets no view of your source at all.
if [ -n "${ADHOC:-}" ]; then
  claudebox_ensure_volume "$CLAUDEBOX_VOL_PY" "$IMAGE"
  VENV="${CLAUDEBOX_DEPS_MOUNT_PY}/bin"
  echo "claudebox-install: adding${PKGS} to the environment (not to any manifest)"

  sidecar \
    -v "$CLAUDEBOX_VOL_PY":"$CLAUDEBOX_DEPS_MOUNT_PY" \
    "$IMAGE" -c \
    "[ -x $VENV/pip ] || python3 -m venv $CLAUDEBOX_DEPS_MOUNT_PY \
       && $VENV/pip install -q --upgrade pip \
       && $VENV/pip install$PKGS \
       && $CHOWN $CLAUDEBOX_DEPS_MOUNT_PY"

  sync_into_running_container "$CLAUDEBOX_VOL_PY" "$CLAUDEBOX_DEPS_MOUNT_PY"
  echo "claudebox-install: done. Available now - no restart."
  exit 0
fi

# ------------------------------------------------------------------ node ---
if [ "$CLAUDEBOX_HAS_NODE" = 1 ]; then
  claudebox_ensure_volume "$CLAUDEBOX_VOL_NODE" "$IMAGE"

  if [ "$POLICY" = lenient ]; then
    # Resolve in a scratch directory inside the container, not in /work.
    # Mounting the volume at /work/node_modules would make Docker create that
    # directory on the host, which is the one thing this is meant to avoid.
    # The project is still mounted read-write so the resolved lockfile can be
    # copied back out.
    sidecar \
      -v "$PWD":/work \
      -v "$CLAUDEBOX_VOL_NODE":/build/node_modules \
      "$IMAGE" -c "mkdir -p /build \
         && cp /work/package.json /build/ \
         && { [ -f /work/package-lock.json ] && cp /work/package-lock.json /build/ || true; } \
         && cd /build && npm install \
         && cp /build/package-lock.json /work/package-lock.json \
         && $CHOWN /build/node_modules"
  else
    if [ ! -f "$PWD/package-lock.json" ]; then
      echo "claudebox-install: no package-lock.json, and the strict policy needs one." >&2
      echo "  Run with --lenient to resolve and write it." >&2
      exit 1
    fi
    sidecar \
      -v "$PWD/package.json":/work/package.json:ro \
      -v "$PWD/package-lock.json":/work/package-lock.json:ro \
      -v "$CLAUDEBOX_VOL_NODE":/work/node_modules \
      -w /work "$IMAGE" -c "npm ci --ignore-scripts && $CHOWN /work/node_modules"
  fi

  echo "claudebox-install: node deps ready in $CLAUDEBOX_VOL_NODE"
  sync_into_running_container "$CLAUDEBOX_VOL_NODE" "$CLAUDEBOX_DEPS_MOUNT_NODE"
fi

# ---------------------------------------------------------------- python ---
if [ "$CLAUDEBOX_HAS_PY" = 1 ]; then
  claudebox_ensure_volume "$CLAUDEBOX_VOL_PY" "$IMAGE"
  VENV="${CLAUDEBOX_DEPS_MOUNT_PY}/bin"
  [ -f "$PWD/requirements.txt" ] && PIP_SRC="-r requirements.txt" || PIP_SRC="."

  if [ "$POLICY" = lenient ]; then
    sidecar \
      -v "$PWD":/work \
      -v "$CLAUDEBOX_VOL_PY":"$CLAUDEBOX_DEPS_MOUNT_PY" \
      -w /work "$IMAGE" -c \
      "python3 -m venv $CLAUDEBOX_DEPS_MOUNT_PY && $VENV/pip install -q --upgrade pip \
         && $VENV/pip install $PIP_SRC && $CHOWN $CLAUDEBOX_DEPS_MOUNT_PY"
  else
    # Building a pyproject is a source build by definition, so there is no
    # strict version of it. --only-binary blocks source distributions, which
    # execute setup.py at install time.
    if [ "$PIP_SRC" = "." ]; then
      echo "claudebox-install: pyproject.toml needs a source build, which the" >&2
      echo "  strict policy disallows. Use --lenient, or add a requirements.txt." >&2
      exit 1
    fi
    sidecar \
      -v "$PWD/requirements.txt":/work/requirements.txt:ro \
      -v "$CLAUDEBOX_VOL_PY":"$CLAUDEBOX_DEPS_MOUNT_PY" \
      -w /work "$IMAGE" -c \
      "python3 -m venv $CLAUDEBOX_DEPS_MOUNT_PY && $VENV/pip install -q --upgrade pip \
         && $VENV/pip install --only-binary :all: -r requirements.txt \
         && $CHOWN $CLAUDEBOX_DEPS_MOUNT_PY"
  fi

  echo "claudebox-install: python deps ready in $CLAUDEBOX_VOL_PY"
  sync_into_running_container "$CLAUDEBOX_VOL_PY" "$CLAUDEBOX_DEPS_MOUNT_PY"
fi

echo "claudebox-install: done. Available now - no restart."
