#!/usr/bin/env bash
# Watch a project directory for install requests from the agent.
#
#   claudebox-watch <project-dir>
#
# The launchers start this in the background for sandbox-root sessions and stop
# it when the container exits. You don't normally run it by hand.
#
# The agent has no network and no Docker socket, so it cannot install anything
# itself. What it can do is create a request file in the directory it shares
# with you; this loop notices, runs claudebox-install there, and writes the
# output somewhere the agent can read back.
#
# An empty request installs what the manifests declare. A request naming
# packages adds just those, leaving the manifests alone - the agent's way of
# saying "I need this for the next few minutes" rather than "this folder
# depends on it". Names are validated by claudebox-install before they reach a
# shell; they arrive from the agent, so they are untrusted input.
#
# What the agent controls, precisely: when this fires, and which packages get
# named. What it does not control is the command - that is fixed here, and the
# names are validated against a plain-package-spec pattern before they reach a
# shell. Letting it name the command, or handing it the Docker socket to run
# one itself, would be a container escape to host root.
#
# Choosing the packages is still a confused-deputy hole by construction: an
# injected page could talk the agent into installing something. It was already
# true when the manifest was the only input, since the agent writes that too.
# The bound on it is that the launchers start this only under a sandbox root,
# where the blast radius is already disposable.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_DIR="${1:?usage: claudebox-watch <project-dir>}"

REQUEST="$PROJECT_DIR/.claudebox-install-request"
LOG="$PROJECT_DIR/.claudebox-install.log"
INTERVAL="${CLAUDEBOX_WATCH_INTERVAL:-2}"

while true; do
  if [ -e "$REQUEST" ]; then
    # Clear the request before acting on it. Clearing afterwards would re-run
    # forever if the install crashed the loop.
    requested="$(tr '\n' ' ' < "$REQUEST" 2>/dev/null || true)"
    rm -f "$REQUEST"

    # Capture the status explicitly rather than leaning on set -e. A compound
    # command on the left of || runs with errexit suppressed, so the earlier
    # shape of this logged success after a failed install - which the agent
    # would have read as "dependencies are ready".
    (
      cd "$PROJECT_DIR" || exit 1
      if [ -n "$requested" ]; then
        echo "=== claudebox-install $requested, requested by the agent ==="
      else
        echo "=== claudebox-install, requested by the agent ==="
      fi
      # --lenient explicitly, rather than letting the installer re-derive the
      # policy. The launchers only start this under a sandbox root, so the
      # answer is already known - and re-deriving it here depends on
      # CLAUDE_SANDBOX_ROOTS having been exported, which would otherwise let
      # the launcher and the installer disagree about the same directory.
      #
      # $requested is unquoted so several names split into separate arguments.
      # Globbing is off so a name containing * cannot expand against the
      # project, and claudebox-install validates each name before it reaches a
      # shell.
      status=0
      set -f
      "$REPO_DIR/claudebox-install" --lenient $requested || status=$?
      set +f
      if [ "$status" -eq 0 ]; then
        echo "=== finished ==="
      else
        echo "=== failed, exit $status ==="
      fi
    ) > "$LOG" 2>&1
  fi
  sleep "$INTERVAL"
done
